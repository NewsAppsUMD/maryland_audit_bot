# Prototype Configuration
# Copy to .env and customize for your deployment

# Flask configuration
FLASK_DEBUG=True
FLASK_SECRET_KEY=your-secret-key-here

# LLM API Keys (required for full functionality)
# Get your keys from the respective providers
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Data paths (relative to the prototype directory)
OLA_REPORTS_PATH=../ola_reports.json
TEXT_FILES_PATH=../text/

# LLM Configuration - Gemini models prioritized for better analysis
DEFAULT_MODEL=gemini-2.0-flash-exp
FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro,llama-3.1-8b-instant

# Analysis settings
MAX_TEXT_LENGTH=50000
PROMPT_TEMPLATE="As a journalist analyzing Maryland government audit reports, identify the top 3-5 most newsworthy issues from these reports. Focus on: fraud/abuse, financial mismanagement, public safety concerns, and significant policy failures. For each issue, provide: 1) Brief description, 2) Potential public impact, 3) Key details for follow-up. Reports: {text}"
